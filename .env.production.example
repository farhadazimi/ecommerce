# -----------------------------------------------------------------------------
# PRODUCTION (Pardis Cloud CCE). Placeholders only - real values are stored in the
# Kubernetes Secret `ecommerce-secrets` (never in git). The services refuse to start
# if secrets are missing, too short, or still contain placeholder markers.
# -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# ---- RDS MySQL 8.0 (Database Subnet 10.0.3.0/24, RDS-SG allows 3306 from CCE-SG) ----
DATABASE_HOST=<rds-private-address>
DATABASE_PORT=3306
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce_app
DATABASE_PASSWORD=<secret>
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
# DATABASE_SSL_CA=/etc/rds/ca.pem        # mount the RDS CA bundle to enforce TLS

# ---- DCS Redis 5.0+ (Database Subnet, DCS-SG allows 6379 from CCE-SG) ----
REDIS_HOST=<dcs-private-address>
REDIS_PORT=6379
REDIS_PASSWORD=<secret>
REDIS_REQUIRED=true
REDIS_SSL=false

# ---- OBS (S3-compatible API) ----
STORAGE_BACKEND=s3
OBS_ENDPOINT=https://obs.<region>.<pardis-cloud-domain>
# OBS_PUBLIC_ENDPOINT=                    # only if browsers must use a different endpoint
OBS_BUCKET_IMAGES=ecommerce-images
OBS_BUCKET_INVOICES=ecommerce-invoices
OBS_ACCESS_KEY=<secret: IAM user limited to these buckets>
OBS_SECRET_KEY=<secret>
OBS_REGION=<region>
OBS_ADDRESSING_STYLE=virtual
# OBS_IMAGES_PUBLIC_BASE_URL=https://ecommerce-images.obs.<region>.<domain>   # if images bucket is public-read / CDN
OBS_SIGNED_URL_TTL=3600

# ---- Security ----
JWT_SECRET=<secret: openssl rand -hex 32>
JWT_EXPIRES_MINUTES=60
INTERNAL_SERVICE_TOKEN=<secret: openssl rand -hex 24>
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://shop.example.com
TRUSTED_PROXIES=10.0.0.0/16
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
EXPOSE_API_DOCS=false

# ---- Service discovery (Kubernetes DNS) ----
ORDER_SERVICE_URL=http://order-service:8001
ORDER_SERVICE_TIMEOUT=10

# ---- SMN notifications ----
NOTIFICATION_BACKEND=webhook
SMN_WEBHOOK_URL=<https endpoint that publishes to the SMN "business" topic>
SMN_WEBHOOK_TOKEN=<secret>

# ---- Business ----
CURRENCY=USD
ORDER_PAYMENT_TIMEOUT_MINUTES=30

# ---- Frontend container ----
API_BASE_URL=                          # empty = same origin via Ingress (/api)
CSP_CONNECT_SRC=
CSP_IMG_SRC=https://ecommerce-images.obs.<region>.<pardis-cloud-domain>
