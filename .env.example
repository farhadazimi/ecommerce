# -----------------------------------------------------------------------------
# Local docker compose configuration (copy to .env). Every value has a safe local
# default in docker-compose.yml, so this file is optional. NEVER commit a real .env.
# For the full list of application variables see .env.development.example /
# .env.production.example and docs/deployment.md.
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# MySQL (stands in for RDS MySQL)
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce
DATABASE_PASSWORD=change-me-local-db-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password

# Redis (stands in for DCS Redis)
REDIS_PASSWORD=change-me-local-redis-password

# SeaweedFS S3 (stands in for OBS)
OBS_ACCESS_KEY=localdevaccesskey
OBS_SECRET_KEY=change-me-local-obs-secret
OBS_BUCKET_IMAGES=ecommerce-images
OBS_BUCKET_INVOICES=ecommerce-invoices
OBS_PUBLIC_ENDPOINT=http://localhost:8333

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
INTERNAL_SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-24

# Browser-facing settings
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_API_BASE_URL=http://localhost:8000
SEED_DEMO_DATA=true

# Image naming (used by docker compose build / make images)
IMAGE_REGISTRY=local
IMAGE_TAG=dev
