# -----------------------------------------------------------------------------
# STAGING - same shape as production; values come from Kubernetes ConfigMap/Secret.
# See .env.production.example for documentation of every variable.
# -----------------------------------------------------------------------------
APP_ENV=staging
LOG_LEVEL=INFO
DATABASE_HOST=<staging-rds-private-address>
DATABASE_PORT=3306
DATABASE_NAME=ecommerce_staging
DATABASE_USER=ecommerce_app
DATABASE_PASSWORD=<from-secret>
REDIS_HOST=<staging-dcs-private-address>
REDIS_PORT=6379
REDIS_PASSWORD=<from-secret>
REDIS_REQUIRED=true
STORAGE_BACKEND=s3
OBS_ENDPOINT=https://obs.<region>.<pardis-cloud-domain>
OBS_BUCKET_IMAGES=ecommerce-images-staging
OBS_BUCKET_INVOICES=ecommerce-invoices-staging
OBS_ACCESS_KEY=<from-secret>
OBS_SECRET_KEY=<from-secret>
OBS_REGION=<region>
JWT_SECRET=<from-secret>
INTERNAL_SERVICE_TOKEN=<from-secret>
COOKIE_SECURE=true
CORS_ORIGINS=https://staging.shop.example.com
ORDER_SERVICE_URL=http://order-service:8001
