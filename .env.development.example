# -----------------------------------------------------------------------------
# DEVELOPMENT - running the services directly on your machine (make dev-backend etc.)
# Load with: set -a; . ./.env.development; set +a
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=DEBUG
LOG_JSON=false

# Database (local MySQL, e.g. from `docker compose up -d mysql` on port 3307)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce
DATABASE_PASSWORD=local-dev-db-password
# DATABASE_URL=sqlite:///./dev.db   # alternative: zero-dependency SQLite

# Redis: leave REDIS_HOST empty to use the in-memory development fallback
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=false

# Storage: local filesystem adapter, served through /api/files with signed URLs
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.local-storage
PUBLIC_BASE_URL=http://localhost:8000

# Security (development-only values; rejected when APP_ENV=staging/production)
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_ENABLED=true

# Service discovery
ORDER_SERVICE_URL=http://127.0.0.1:8001

# Frontend (vite dev server)
VITE_API_BASE_URL=http://localhost:8000
